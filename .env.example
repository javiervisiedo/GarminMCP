# ==============================================================================
# Garmin Coach MCP Server (.env.example)
# Copy this file to .env or export these variables in your MCP client config.
# NEVER commit your actual .env file or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Authentication (Garmin Connect / Garth OAuth Token Store)
# ------------------------------------------------------------------------------
# Recommended: Run `garmin-coach-mcp auth` once interactively to complete
# MFA/2FA login and store OAuth1/OAuth2 session tokens in GARMIN_TOKEN_DIR.
#
# Directory where OAuth1 (`oauth1_token.json`) and OAuth2 (`oauth2_token.json`)
# tokens are stored with restricted 0700/0600 permissions.
GARMIN_TOKEN_DIR=~/.garminconnect

# Optional Base64-encoded portable token bundle produced by
# `garmin-coach-mcp export-tokens` for stateless Cloud Run / container
# deployments. When set and `GARMIN_TOKEN_DIR` is empty, `GarminAuthManager`
# automatically hydrates `oauth1_token.json` and `oauth2_token.json` (`0600`).
GARMIN_TOKEN_BASE64=

# Optional headless fallback credentials (only used if saved tokens are not
# found or cannot be refreshed, and the account does not require interactive MFA).
GARMIN_EMAIL=your-email@example.com
GARMIN_PASSWORD=your-password

# ------------------------------------------------------------------------------
# 2. Local SQLite TTL Cache Configuration
# ------------------------------------------------------------------------------
# Directory for the local SQLite response cache (`cache.db`) to prevent Garmin
# Connect HTTP 429 rate limits and speed up repeated coaching queries.
GARMIN_CACHE_DIR=~/.cache/garmin-coach-mcp

# Default cache Time-To-Live (TTL) in seconds for volatile daily telemetry
# (default: 900 = 15 minutes). Historical activities & workouts use longer TTLs.
GARMIN_CACHE_TTL=900

# ------------------------------------------------------------------------------
# 3. Coaching & Unit Preferences
# ------------------------------------------------------------------------------
# Unit system for distances, paces, elevations, temperatures, and weights.
# Supported values: "metric" (km, min/km, m, kg, °C) or "imperial" (mi, min/mi, ft, lbs, °F)
GARMIN_UNITS=metric

# ------------------------------------------------------------------------------
# 4. Remote HTTP Transport & Cloud Run / `gemini.google.com` Configuration
# ------------------------------------------------------------------------------
# MCP transport protocol.
# Supported values:
#   - "stdio" (default for local MCP clients: Claude Desktop, Cursor, Antigravity, Gemini CLI)
#   - "streamable-http" (for gemini.google.com Connected Apps, Gemini Enterprise & Cloud Run)
#   - "sse" (legacy Server-Sent Events transport)
GARMIN_MCP_TRANSPORT=stdio

# Bearer token secret for authenticating remote HTTP requests (`Authorization: Bearer <token>`)
# when running with `streamable-http` or `sse`. Strongly recommended for Cloud Run / tunnels.
GARMIN_MCP_AUTH_TOKEN=

# HTTP port when running in `streamable-http` or `sse` mode (falls back to `PORT` or 8000).
GARMIN_MCP_PORT=8000
